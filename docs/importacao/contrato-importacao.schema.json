{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Casa Serena — rascunho de extração v1 (não é backup nem lançamento)",
  "description": "Contrato de rascunho. O aplicativo 0.3.2 valida e mostra uma conferência local por texto/arquivo; ainda não confirma lançamentos financeiros do lote. Campos essenciais desconhecidos precisam ser resolvidos antes da confirmação futura.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "batchLabel",
    "documents",
    "warnings"
  ],
  "properties": {
    "format": {
      "const": "casa-serena-import"
    },
    "version": {
      "const": 1
    },
    "batchLabel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceImages",
        "kind",
        "eventHint",
        "reference",
        "transactionId",
        "issuedOn",
        "dueOn",
        "paidOn",
        "currency",
        "merchant",
        "transactionStatus",
        "direction",
        "totals",
        "paymentMethod",
        "lineItems",
        "evidence",
        "uncertainties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^doc-[0-9]{3}$"
        },
        "sourceImages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "kind": {
          "enum": [
            "itemized_purchase",
            "payment_receipt",
            "utility_bill",
            "income_receipt",
            "other"
          ]
        },
        "eventHint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "transactionId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "issuedOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "dueOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "paidOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "merchant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "branch",
            "locality"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "branch": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "locality": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            }
          }
        },
        "transactionStatus": {
          "enum": [
            "completed",
            "scheduled",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "direction": {
          "enum": [
            "outgoing",
            "incoming",
            "own_transfer",
            "unknown"
          ]
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "itemsGrossCents",
            "discountCents",
            "extraCents",
            "totalCents",
            "amountPaidCents"
          ],
          "properties": {
            "itemsGrossCents": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "discountCents": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "extraCents": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalCents": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "amountPaidCents": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "paymentMethod": {
          "enum": [
            "pix",
            "cash",
            "debit_card",
            "credit_card",
            "bank_transfer",
            "boleto",
            "mixed",
            "other",
            "unknown"
          ]
        },
        "lineItems": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/lineItem"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "uncertainties": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineId",
        "sourceText",
        "description",
        "suggestedProduct",
        "brand",
        "gtin",
        "soldQuantity",
        "soldUnit",
        "packageSize",
        "packageUnit",
        "unitPriceDecimal",
        "grossLineCents",
        "lineDiscountCents",
        "netLineCents",
        "uncertainties"
      ],
      "properties": {
        "lineId": {
          "type": "string",
          "pattern": "^line-[0-9]{3}$"
        },
        "sourceText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "suggestedProduct": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "brand": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "gtin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9]{8}|[0-9]{12,14})$"
        },
        "soldQuantity": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:0|[1-9][0-9]{0,8})(?:\\.[0-9]{1,6})?$"
        },
        "soldUnit": {
          "enum": [
            "un",
            "kg",
            "g",
            "l",
            "ml",
            "m",
            "cm",
            "other",
            "unknown"
          ]
        },
        "packageSize": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:0|[1-9][0-9]{0,8})(?:\\.[0-9]{1,6})?$"
        },
        "packageUnit": {
          "enum": [
            "un",
            "kg",
            "g",
            "l",
            "ml",
            "m",
            "cm",
            "other",
            "unknown"
          ]
        },
        "unitPriceDecimal": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:0|[1-9][0-9]{0,8})(?:\\.[0-9]{1,6})?$"
        },
        "grossLineCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lineDiscountCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "netLineCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncertainties": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
